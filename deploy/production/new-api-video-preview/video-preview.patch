+import { Download, Film, LoaderCircle } from 'lucide-react'
+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+
+import { Dialog } from '@/components/dialog'
+import { Button } from '@/components/ui/button'
+import { api } from '@/lib/api'
+
+interface VideoPreviewDialogProps {
+  taskId: string
+  onClose: () => void
+}
+
+export function VideoPreviewDialog(props: VideoPreviewDialogProps) {
+  const { t } = useTranslation()
+  const [videoUrl, setVideoUrl] = useState('')
+  const [failed, setFailed] = useState(false)
+  const [attempt, setAttempt] = useState(0)
+
+  useEffect(() => {
+    const controller = new AbortController()
+    let objectUrl = ''
+    // Use the existing authenticated client, never an upstream URL or a key in a URL.
+    void api
+      .get<Blob>(`/v1/videos/${encodeURIComponent(props.taskId)}/content`, {
+        responseType: 'blob',
+        signal: controller.signal,
+        timeout: 120000,
+        disableDuplicate: true,
+        skipErrorHandler: true,
+      })
+      .then((response) => {
+        if (controller.signal.aborted) return
+        const blob = response.data
+        if (
+          !blob.size ||
+          (!blob.type.startsWith('video/') &&
+            blob.type !== 'application/octet-stream')
+        ) {
+          throw new Error('Invalid video response')
+        }
+        objectUrl = URL.createObjectURL(blob)
+        setVideoUrl(objectUrl)
+      })
+      .catch(() => {
+        if (!controller.signal.aborted) setFailed(true)
+      })
+    return () => {
+      controller.abort()
+      if (objectUrl) URL.revokeObjectURL(objectUrl)
+    }
+  }, [props.taskId, attempt])
+
+  return (
+    <Dialog
+      open
+      onOpenChange={(open) => {
+        if (!open) props.onClose()
+      }}
+      title={t('Video Preview')}
+      description={t('Preview and download the completed video.')}
+      contentClassName='sm:max-w-4xl'
+      bodyClassName='space-y-4'
+    >
+      {failed && (
+        <div role='alert' className='space-y-3 py-6 text-center'>
+          <p>{t('Unable to load video. Please try again.')}</p>
+          <Button
+            variant='outline'
+            onClick={() => {
+              setFailed(false)
+              setVideoUrl('')
+              setAttempt((value) => value + 1)
+            }}
+          >
+            {t('Retry')}
+          </Button>
+        </div>
+      )}
+      {!failed && videoUrl && (
+        <>
+          <video
+            src={videoUrl}
+            controls
+            playsInline
+            aria-label={t('Video Preview')}
+            className='max-h-[60vh] w-full rounded-lg bg-black'
+            onError={() => setFailed(true)}
+          />
+          <a
+            href={videoUrl}
+            download={`${props.taskId}.mp4`}
+            className='focus-visible:ring-ring inline-flex items-center gap-2 rounded-md border px-3 py-2 text-sm hover:underline focus-visible:ring-2'
+          >
+            <Download aria-hidden='true' className='size-4' />
+            {t('Download')}
+          </a>
+        </>
+      )}
+      {!failed && !videoUrl && (
+        <div
+          role='status'
+          className='flex items-center justify-center gap-2 py-12'
+        >
+          <LoaderCircle aria-hidden='true' className='size-5 animate-spin' />
+          {t('Loading')}
+        </div>
+      )}
+    </Dialog>
+  )
+}
+
+export function VideoResultCell(props: { taskId: string }) {
+  const { t } = useTranslation()
+  const [open, setOpen] = useState(false)
+  return (
+    <>
+      <button
+        type='button'
+        onClick={() => setOpen(true)}
+        aria-haspopup='dialog'
+        className='text-foreground focus-visible:ring-ring inline-flex items-center gap-1 rounded-sm text-xs hover:underline focus-visible:ring-2'
+      >
+        <Film aria-hidden='true' className='size-3' />
+        {t('View result')}
+      </button>
+      {open && (
+        <VideoPreviewDialog
+          taskId={props.taskId}
+          onClose={() => setOpen(false)}
+        />
+      )}
+    </>
+  )
+}
