+import assert from 'node:assert/strict'
+import { after, afterEach, beforeEach, test } from 'node:test'
+
+import type { CellContext } from '@tanstack/react-table'
+import type { AxiosAdapter, AxiosRequestConfig } from 'axios'
+import { Window } from 'happy-dom'
+import type React from 'react'
+
+import zhCN from '@/i18n/locales/zh.json'
+
+import type { TaskLog } from '../../types'
+
+const dom = new Window({ url: 'http://localhost' })
+for (const key of [
+  'window',
+  'document',
+  'navigator',
+  'HTMLElement',
+  'HTMLVideoElement',
+  'SVGElement',
+  'Node',
+  'Element',
+  'Event',
+  'CustomEvent',
+  'MutationObserver',
+  'requestAnimationFrame',
+  'cancelAnimationFrame',
+  'getComputedStyle',
+  'ResizeObserver',
+] as const) {
+  Object.defineProperty(globalThis, key, {
+    configurable: true,
+    value: dom[key],
+  })
+}
+Object.defineProperty(globalThis, 'IS_REACT_ACT_ENVIRONMENT', {
+  configurable: true,
+  value: true,
+})
+const { act, createElement } = await import('react')
+const { createRoot } = await import('react-dom/client')
+const { createInstance } = await import('i18next')
+const { I18nextProvider, initReactI18next } = await import('react-i18next')
+const { useTaskLogsColumns } = await import('../columns/task-logs-columns')
+const { api } = await import('@/lib/api')
+const { useAuthStore } = await import('@/stores/auth-store')
+const i18n = createInstance()
+await i18n
+  .use(initReactI18next)
+  .init({ lng: 'en', resources: { en: { translation: {} }, zhCN } })
+const adapter = api.defaults.adapter
+const oldCreate = URL.createObjectURL
+const oldRevoke = URL.revokeObjectURL
+let revoked: string[] = []
+let roots: ReturnType<typeof createRoot>[] = []
+const task: TaskLog & { result_url: string } = {
+  id: 1,
+  user_id: 1,
+  platform: '1',
+  task_id: 'task_existing',
+  action: 'textGenerate',
+  channel_id: 61,
+  submit_time: 1,
+  status: 'SUCCESS',
+  progress: '100%',
+  fail_reason: '',
+  result_url: '/v1/videos/task_existing/content',
+}
+function Details(props: { log: TaskLog }): React.ReactNode {
+  const column = useTaskLogsColumns(false).find(
+    (c) => 'accessorKey' in c && c.accessorKey === 'fail_reason'
+  )
+  const Cell = column?.cell
+  assert.equal(typeof Cell, 'function')
+  return createElement(
+    Cell as React.ComponentType<CellContext<TaskLog, unknown>>,
+    {
+      row: { original: props.log, getValue: () => props.log.fail_reason },
+    } as unknown as CellContext<TaskLog, unknown>
+  )
+}
+async function render(log: TaskLog = task): Promise<HTMLDivElement> {
+  const container = document.createElement('div')
+  document.body.append(container)
+  const root = createRoot(container)
+  roots.push(root)
+  await act(async () =>
+    root.render(
+      <I18nextProvider i18n={i18n}>
+        <Details log={log} />
+      </I18nextProvider>
+    )
+  )
+  return container
+}
+function button(name: string): HTMLButtonElement {
+  const el = [...document.querySelectorAll('button')].find(
+    (b) => b.textContent?.trim() === name
+  )
+  assert.ok(el, `Expected button: ${name}`)
+  return el
+}
+async function click(name: string): Promise<void> {
+  await act(async () => button(name).click())
+}
+function response(
+  config: AxiosRequestConfig,
+  data = new Blob(['video'], { type: 'video/mp4' })
+) {
+  return {
+    data,
+    status: 200,
+    statusText: 'OK',
+    headers: { 'content-type': data.type },
+    config,
+  } as Awaited<ReturnType<AxiosAdapter>>
+}
+beforeEach(() => {
+  revoked = []
+  URL.createObjectURL = () => 'blob:test-video'
+  URL.revokeObjectURL = (url) => revoked.push(url)
+  useAuthStore.setState((state) => ({
+    auth: { ...state.auth, accessToken: 'dashboard-test-credential' },
+  }))
+})
+afterEach(async () => {
+  await act(async () => {
+    for (const root of roots) root.unmount()
+  })
+  roots = []
+  document.body.innerHTML = ''
+  api.defaults.adapter = adapter
+  useAuthStore.setState((state) => ({
+    auth: { ...state.auth, accessToken: null },
+  }))
+})
+after(() => {
+  URL.createObjectURL = oldCreate
+  URL.revokeObjectURL = oldRevoke
+  dom.close()
+})
+
+test('successful video with result_url and empty fail_reason offers a result button without fetching early', async () => {
+  let requests = 0
+  api.defaults.adapter = async (config) => {
+    requests++
+    return response(config)
+  }
+  await render()
+  assert.ok(button('View result'))
+  assert.equal(requests, 0)
+})
+test('opening result fetches only same-origin video with existing dashboard auth and offers playback and download', async () => {
+  let request: AxiosRequestConfig | undefined
+  api.defaults.adapter = async (config) => {
+    request = config
+    return response(config)
+  }
+  await render({
+    ...task,
+    result_url: 'https://upstream.example/private-video',
+  } as TaskLog)
+  await click('View result')
+  assert.equal(request?.url, '/v1/videos/task_existing/content')
+  assert.equal(
+    request?.headers?.Authorization,
+    'Bearer dashboard-test-credential'
+  )
+  assert.equal(request?.responseType, 'blob')
+  const video = document.querySelector('video')
+  assert.ok(video)
+  assert.equal(video.getAttribute('src'), 'blob:test-video')
+  assert.equal(video.controls, true)
+  const download = document.querySelector('a[download]')
+  assert.equal(download?.getAttribute('href'), 'blob:test-video')
+})
+test('legacy successful video URL still offers result while failed and unfinished tasks do not', async () => {
+  await render({
+    ...task,
+    result_url: undefined,
+    fail_reason: 'https://legacy.example/video',
+  } as TaskLog)
+  assert.ok(button('View result'))
+  await act(async () => {
+    for (const root of roots) root.unmount()
+  })
+  roots = []
+  document.body.innerHTML = ''
+  await render({ ...task, status: 'FAILURE', fail_reason: 'Generation failed' })
+  assert.equal(document.body.textContent?.includes('View result'), false)
+  assert.equal(document.body.textContent?.includes('Generation failed'), true)
+})
+test('failed video download shows a retry action without exposing a player or a broken download link', async () => {
+  api.defaults.adapter = async () => {
+    throw new Error('upstream unavailable')
+  }
+  await render()
+  await click('View result')
+  assert.ok(button('Retry'))
+  assert.equal(document.querySelector('video'), null)
+  assert.equal(document.querySelector('a[download]'), null)
+  api.defaults.adapter = async (config) => response(config)
+  await click('Retry')
+  assert.ok(document.querySelector('video'))
+})
+test('a JSON error body returned as HTTP 200 is not treated as a downloadable video', async () => {
+  api.defaults.adapter = async (config) =>
+    response(
+      config,
+      new Blob(['{"error":"invalid token"}'], { type: 'application/json' })
+    )
+  await render()
+  await click('View result')
+  assert.ok(button('Retry'))
+  assert.equal(document.querySelector('video'), null)
+})
+test('closing result releases its local video URL', async () => {
+  api.defaults.adapter = async (config) => response(config)
+  await render()
+  await click('View result')
+  await act(async () => {
+    for (const root of roots) root.unmount()
+  })
+  roots = []
+  assert.deepEqual(revoked, ['blob:test-video'])
+})
+test('closing a pending preview cancels the read request', async () => {
+  let signal: AxiosRequestConfig['signal']
+  api.defaults.adapter = (config) => {
+    signal = config.signal
+    return new Promise(() => {})
+  }
+  await render()
+  await click('View result')
+  assert.equal(signal?.aborted, false)
+  await act(async () => {
+    for (const root of roots) root.unmount()
+  })
+  roots = []
+  assert.equal(signal?.aborted, true)
+})
+
+test('Chinese result dialog and download use the actual locale resource', async () => {
+  await i18n.changeLanguage('zhCN')
+  try {
+    api.defaults.adapter = async (config) => response(config)
+    await render()
+    await click('查看结果')
+    assert.equal(
+      document.querySelector('a[download]')?.textContent?.trim(),
+      '下载'
+    )
+    assert.ok(document.querySelector('video[aria-label="视频预览"]'))
+  } finally {
+    await act(async () => i18n.changeLanguage('en'))
+  }
+})
+
+test('unfinished video and successful non-video task do not offer video preview', async () => {
+  await render({ ...task, status: 'IN_PROGRESS' })
+  await render({ ...task, action: 'LYRICS' })
+  assert.equal(document.querySelector('[aria-haspopup="dialog"]'), null)
+})
