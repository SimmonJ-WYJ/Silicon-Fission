# 生产环境变量 —— 复制为 .env,把所有 CHANGE_ME 改成强随机值。
# 生成随机串:  openssl rand -hex 32

# 你的主域名（不要填写 api. 子域名）。例：siliconfission.com
DOMAIN=yourdomain.com

# PostgreSQL
PG_USER=sfuser
PG_PASSWORD=CHANGE_ME_strong_db_password
PG_DB=newapi

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# new-api 会话/签名密钥(必须改,随机 32+ 字节)
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# 自研网关(api.域名)的主 Key,客户端用 Authorization: Bearer <值> 调用
SF_MASTER_KEY=sk-sf-CHANGE_ME

# 上游供应商 Key(可选,留空则该供应商不参与网关路由)
# new-api 的渠道在后台界面里配置,不用写在这里
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
