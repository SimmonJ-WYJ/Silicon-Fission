# Caddy 为每个站点自动申请并续期 Let's Encrypt 证书。
# DOMAIN 由 .env 注入(如 siliconfission.com)。

# 主站统一使用 new-api 原生前端；www 永久跳转到主域名。
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
    encode gzip

    handle_path /brand/* {
        root * /srv/brand
        file_server
    }

    handle {
        reverse_proxy new-api:3000
    }
}

# 自定义网关:统一 OpenAI 兼容 API 入口
# 前置:api.{$DOMAIN} 的 A 记录需指向本机公网 IP,否则签发证书会失败。
api.{$DOMAIN} {
	encode gzip
	reverse_proxy gateway:8788 {
		# 流式响应(SSE)必须关闭缓冲,否则 token 会被攒着一次性吐出
		flush_interval -1
	}
}
