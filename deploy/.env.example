# 硅基裂变部署环境变量 —— 复制为 .env 并全部改成你自己的强随机值。
# 生成随机串示例:  openssl rand -hex 32

# 对外端口
SF_PORT=3000

# PostgreSQL
PG_USER=sfuser
PG_PASSWORD=CHANGE_ME_strong_db_password
PG_DB=newapi

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# new-api 会话/签名密钥(必须改,随机 32+ 字节)
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# 生产 HTTPS 域名(deploy/production 用;Caddy 会同时签发 api.<DOMAIN>)
DOMAIN=siliconfission.com

# ── 自定义网关(sf-gateway)────────────────────────────────
# 客户端调用网关时的主 Key:Authorization: Bearer <SF_MASTER_KEY>
SF_MASTER_KEY=CHANGE_ME_sk_sf_random

# 上游供应商 Key(留空则该供应商不参与路由)
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
